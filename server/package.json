{
  "name": "ict-club-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/index.js",
    "seed": "node --disable-warning=ExperimentalWarning src/seed.js",
    "reset": "node --disable-warning=ExperimentalWarning src/seed.js --reset",
    "test": "node ../scripts/run-tests.mjs api",
    "admin": "node --disable-warning=ExperimentalWarning src/set-admin.js",
    "test:isolated": "node ../scripts/run-tests.mjs api",
    "test:live": "node ../scripts/run-tests.mjs api --live",
    "demo": "node --disable-warning=ExperimentalWarning src/seed.js --demo"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0"
  }
}
