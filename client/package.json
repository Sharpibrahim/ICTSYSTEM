    "test:flows:direct": "npm run test:build && node test/flows.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^30.1.1",
    "vite": "^7.0.0"
  }
}
