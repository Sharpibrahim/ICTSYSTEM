{
  "name": "ict-club-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node ../scripts/run-tests.mjs ui",
    "test:build": "vite build --ssr test/ssr-entry.jsx --outDir test/dist --logLevel warn",
    "test:flows": "node ../scripts/run-tests.mjs flows",
