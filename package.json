{
  "name": "ict-club-management-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ICT Club Management System for a secondary school \u2014 plain HTML, CSS and JavaScript front end on a Node + SQLite API",
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "start": "npm --prefix server start",
    "dev": "npm --prefix server run dev",
    "dev:api": "npm --prefix server run dev",
    "setup": "npm install --no-audit --no-fund && npm --prefix server install --no-audit --no-fund",
    "db:seed": "npm --prefix server run seed",
    "db:reset": "npm --prefix server run reset",
    "db:demo": "npm --prefix server run demo",
    "admin": "npm --prefix server run admin --",
    "test": "node scripts/run-tests.mjs",
    "test:api": "node scripts/run-tests.mjs api",
    "test:ui": "node scripts/run-tests.mjs ui",
    "test:flows": "node scripts/run-tests.mjs flows",
    "test:empty": "node scripts/run-tests.mjs empty",
    "test:live": "node scripts/run-tests.mjs --live"
  },
  "devDependencies": {
    "jsdom": "^30.0.0"
  }
}
